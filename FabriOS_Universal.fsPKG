apps/interceptor.lua
local argumentos_comando = { ... }
local comando = table.remove(argumentos_comando, 1)

-- Resolver programas, con o sin .lua
local function resolveProgram(path)
    if not path or path == "" then
        return nil
    end

    local function buscar(candidato)
        if fs.exists(candidato) and not fs.isDir(candidato) then
            return shell.resolve(candidato)
        end

        -- Si no tiene extensión, probar con .lua
        if not candidato:match("%.[^/]+$") then
            local lua = candidato .. ".lua"

            if fs.exists(lua) and not fs.isDir(lua) then
                return shell.resolve(lua)
            end
        end

        return nil
    end

    -- Buscar directamente
    local resultado = buscar(path)
    if resultado then
        return resultado
    end

    -- Buscar en el PATH
    for dir in shell.path():gmatch("[^:]+") do
        resultado = buscar(fs.combine(dir, path))

        if resultado then
            return resultado
        end
    end

    return nil
end

-- Analizar una línea de comandos
local function parseCommandLine(line)
    local argumentos = {}
    local actual = {}
    local comillas = nil
    local escapado = false
    local dentro = false

    for i = 1, #line do
        local c = line:sub(i, i)

        if escapado then
            actual[#actual + 1] = c
            escapado = false
            dentro = true

        elseif c == "\\" then
            escapado = true
            dentro = true

        elseif comillas then
            if c == comillas then
                comillas = nil
            else
                actual[#actual + 1] = c
            end

        elseif c == '"' or c == "'" then
            comillas = c
            dentro = true

        elseif c:match("%s") then
            if dentro then
                argumentos[#argumentos + 1] = table.concat(actual)
                actual = {}
                dentro = false
            end

        else
            actual[#actual + 1] = c
            dentro = true
        end
    end

    if escapado then
        actual[#actual + 1] = "\\"
    end

    if dentro then
        argumentos[#argumentos + 1] = table.concat(actual)
    end

    return argumentos
end

-- Resolver el comando inicial
comando = resolveProgram(comando)

-- Crear entorno personalizado
local env_modificado = {}

for k, v in pairs(_ENV) do
    env_modificado[k] = v
end

-- Copiar os
local os_modificado = {}

for k, v in pairs(os) do
    os_modificado[k] = v
end

-- Copiar shell
local shell_modificado = {}

for k, v in pairs(shell) do
    shell_modificado[k] = v
end

-- Guardar funciones originales
local pullEventOriginal = os.pullEvent
local pullEventRawOriginal = os.pullEventRaw

-- Interceptar os.pullEvent
os_modificado.pullEvent = function(...)
    print("!!! pullEvent Interceptado !!!")
    return pullEventOriginal(...)
end

-- Interceptar os.pullEventRaw
os_modificado.pullEventRaw = function(...)
    print("!!! pullEventRaw Interceptado !!!")
    return pullEventRawOriginal(...)
end

-- Crear shell.run personalizado
shell_modificado.run = function(comando, ...)
    local argumentos

    if select("#", ...) == 0 then
        argumentos = parseCommandLine(comando or "")
    else
        argumentos = { comando, ... }
    end

    local programa = table.remove(argumentos, 1)

    if not programa or programa == "" then
        return false
    end

    programa = resolveProgram(programa)

    if not programa then
        return false
    end

    return os.run(
        env_modificado,
        programa,
        table.unpack(argumentos)
    )
end

-- Crear shell.execute personalizado
shell_modificado.execute = function(comando)
    if type(comando) ~= "string" then
        error("bad argument #1 (string expected)", 2)
    end

    local argumentos = parseCommandLine(comando)
    local programa = table.remove(argumentos, 1)

    if not programa or programa == "" then
        return false
    end

    programa = resolveProgram(programa)

    if not programa then
        return false
    end

    return os.run(
        env_modificado,
        programa,
        table.unpack(argumentos)
    )
end

-- Instalar las tablas modificadas
env_modificado.os = os_modificado
env_modificado.shell = shell_modificado

-- Comprobar el programa inicial
if not comando then
    printError("Programa no encontrado")
    return
end

-- Información de depuración
print("Original:", os.pullEvent)
print("Modificado:", env_modificado.os.pullEvent)

-- Ejecutar el programa inicial
os.run(
    env_modificado,
    comando,
    table.unpack(argumentos_comando)
)
