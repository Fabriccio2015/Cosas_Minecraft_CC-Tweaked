local argumentos = {...}
local carpeta = shell.resolve(argumentos[1] or ".")

for _, i in ipairs(fs.list(carpeta)) do
    write(i)
    if fs.isDir(fs.combine(carpeta, i)) then
        write("/")
    end
    write("\n")
end

